{
  "name": "ajg-seaside-caravans",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "prisma:generate": "prisma generate",
    "db:migrate:local": "wrangler d1 migrations apply ajg-seaside-caravans --local",
    "db:migrate:remote": "wrangler d1 migrations apply ajg-seaside-caravans --remote",
    "db:seed:local": "wrangler d1 execute ajg-seaside-caravans --local --file=./migrations/seed.sql",
    "db:seed:remote": "wrangler d1 execute ajg-seaside-caravans --remote --file=./migrations/seed.sql"
  },
  "dependencies": {
    "next": "15.5.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^3.4.4",
    "prisma": "^5.16.1",
    "@prisma/client": "^5.16.1",
    "@prisma/adapter-d1": "^5.16.1",
    "stripe": "^16.2.0",
    "react-day-picker": "^8.10.1",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@cloudflare/workers-types": "^5.20260815.1",
    "wrangler": "^4.124.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "typescript": "^5.5.3",
    "@types/react": "^18.3.3",
    "@types/node": "^20.14.11"
  }
}
